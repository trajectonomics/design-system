{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"root": true,
	"extends": ["@trajectonomics/tooling/configs/web"],
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/coverage",
			"!**/*.md",
			"!**/skills-lock.json",
			"!**/*.css",
			"!**/*.svelte",
			"!**/.svelte-kit",
			"!**/.svelte-check",
			"!**/.agents",
			"!**/.claude"
		]
	}
}
