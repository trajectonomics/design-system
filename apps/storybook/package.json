{
	"name": "@trajectonomics/storybook",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "storybook build",
		"dev": "storybook dev -p 6006",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format:svelte": "prettier --plugin prettier-plugin-svelte --write --no-error-on-unmatched-pattern \"src/**/*.svelte\"",
		"lint": "biome ci --error-on-warnings . && prettier --plugin prettier-plugin-svelte --check --no-error-on-unmatched-pattern \"src/**/*.svelte\""
	},
	"devDependencies": {
		"@storybook/addon-a11y": "^10.6.6",
		"@storybook/svelte-vite": "^10.6.6",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@trajectonomics/design-system": "workspace:*",
		"@trajectonomics/design-system-svelte": "workspace:*",
		"@trajectonomics/design-system-theme": "workspace:*",
		"@types/bun": "^1.4.4",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"storybook": "^10.6.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"vite": "^8.3.6"
	}
}
