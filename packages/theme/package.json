{
	"name": "@trajectonomics/design-system-theme",
	"version": "0.0.0-development",
	"description": "Trajectonomics design system: Theme definition, validation and CSS emission",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trajectonomics/design-system.git",
		"directory": "packages/theme"
	},
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=20.0.0"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./themes/light.css": "./dist/themes/light.css",
		"./themes/dark.css": "./dist/themes/dark.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"tag": "latest"
	},
	"scripts": {
		"build": "tsdown && bun run build:css",
		"build:css": "bun run scripts/build-theme-css.ts",
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
		"lint": "biome ci --error-on-warnings .",
		"lint:package": "publint --strict && attw --pack . --profile node16 --exclude-entrypoints ./themes/light.css ./themes/dark.css"
	},
	"peerDependencies": {
		"@trajectonomics/design-system": "^0.1.0"
	},
	"devDependencies": {
		"@trajectonomics/design-system": "workspace:*",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
